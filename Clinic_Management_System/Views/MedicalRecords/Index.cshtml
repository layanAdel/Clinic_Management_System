@using Clinic_Management_System.Application.Dtos
@model IEnumerable<MedicalRecordDto>

    @{
    ViewData["Title"] = "MedicalRecords Page";
} 

<div class="container">

    <h1>MedicalRecords</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary"> New MedicalRecord </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Patient Name</th>
                <th>Doctor Name</th>
                <th>Visit Date</th>
                <th>Diagnosis</th>
                <th>Doctor Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var med in Model)
            {

                <tr>
                    <td>@med.Id</td>
                    <td>@med.PatientName</td>
                    <td>@med.DoctorName</td>
                    <td>@med.VisitDate</td>
                    <td>@med.Diagnosis</td>
                    <td>@med.Notes</td>

                    <td>
                        <a asp-action="Edit"  asp-route-uuid="@med.Uuid" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete"  asp-route-uuid="@med.Uuid" class="btn btn-danger"> Delete  </a>
                    </td>

                </tr>

            }


        </tbody>

    </table>
</div>