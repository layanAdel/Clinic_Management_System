@model Clinic_Management_System.Models.MedicalRecord


ViewData["Title"] = "Delete MedicalRecord";
}


<div class="container">
    <h1>Delete MedicalRecord</h1>
    <form asp-action="Delete" method="post " asp-route-Uuid="@Model.Uuid">

       
        <div class="form-group">
            <label asp-for="PatientId" class="control-label"></label>
            <input asp-for="PatientId" class="form-control" readonly />
        </div>


        <div class="form-group">
            <label asp-for="DoctorId" class="control-label"></label>
            <input asp-for="DoctorId" class="form-control" readonly />
        </div>


        
        <div class="form-group">
            <label asp-for="VisitDate" class="control-label"></label>
            <input asp-for="VisitDate" class="form-control" readonly />
        </div>

        
        <div class="form-group">
            <label asp-for="Diagnosis" class="control-label"></label>
            <input asp-for="Diagnosis" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="Notes" class="control-label"></label>
            <input asp-for="Notes" class="form-control" readonly />
        </div>


        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger mt-3" />
        </div>
        <input type="hidden" asp-for="Uuid" />

    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>