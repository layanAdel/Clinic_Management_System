@using Clinic_Management_System.Application.Dtos
@model PatientUpdateDto
@{
    ViewData["Title"] = "Delete Patient";
}


<div class="container">
    <h1>Delete Patient</h1>
    <form asp-action="Delete" method="post" asp-route-Uuid="@Model.Uuid">

       

        <div class="form-group">
            <label asp-for="FirstName" class="control-label"></label>
            <input asp-for="FirstName" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="LastName" class="control-label"></label>
            <input asp-for="LastName" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="BirthDate" class="control-label"></label>
            <input asp-for="BirthDate" class="form-control" readonly>
        </div>

        <div class="form-group">
            <label asp-for="Gender" class="control-label"></label>
            <input asp-for="Gender" class="form-control" readonly>
        </div>

        <div class="form-group">
            <label asp-for="Phone" class="control-label"></label>
            <input asp-for="Phone" class="form-control" readonly>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="control-label"></label>
            <input asp-for="Email" class="form-control" readonly>
        </div>

       
        <div class="form-group">
            <input type="hidden" asp-for="Uuid" />

            <input type="submit" value="Delete" class="btn btn-danger mt-3" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>