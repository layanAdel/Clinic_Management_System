@model Department
@{
    ViewData["Title"] = "Delete Department";
}


<div class="container">
    <h1>Delete Department</h1>
    <form asp-action="Delete" method="post" asp-route-Uuid="@Model.Uuid">

       
          
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <input asp-for="Description" class="form-control" readonly />
        </div>


        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger mt-3" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>