@using Clinic_Management_System.Application.Dtos
@model IEnumerable<PrescriptionDto>

     @{
    ViewData["Title"] = "Prescriptions Page";
}

<div class="container">

    <h1>Prescriptions</h1>

    <div class="text-end">
        <a asp-action="Create" class="btn btn-primary"> New Prescription </a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Patient Name</th>
                <th>Doctor Name</th>
                <th>Medication</th>
                <th>Dosage</th>
                <th>Instructions</th>
                <th>Prescription Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pre in Model)
            {

                <tr>
                    <td>@pre.Id</td>
                    <td>@pre.PatientName</td>
                    <td>@pre.DoctorName</td>
                    <td>@pre.Medication</td>
                    <td>@pre.Dosage</td>
                    <td>@pre.Instructions</td>
                    <td>@pre.PrescriptionDate</td>

                    <td>
                        <a asp-action="Edit"  asp-route-uuid="@pre.Uuid" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete"  asp-route-uuid="@pre.Uuid" class="btn btn-danger"> Delete  </a>
                    </td>

                </tr>

            }


        </tbody>

    </table>
</div>