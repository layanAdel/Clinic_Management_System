@using Clinic_Management_System.Dtos
@model InvoiceUpdateDto
@{
    ViewData["Title"] = "Edit Invoice";

}

<div class="container">
    <h1>Edit Invoices</h1>
    <form asp-action="Edit" method="post" asp-route-Uuid="@Model.Uuid">
        <input type="hidden" asp-for="Uuid" />

        <div class="text-danger" asp-validation-summary="All">
        </div>

       
        <div class="form-group">
            <label asp-for="PatientId" class="control-label"></label>

            <select asp-for="PatientId" class="form-control" asp-items="ViewBag.Patients">
                <option value="">-- Select Patients --</option>
            </select>

            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>
        
        
        <div class="form-group">
            <label asp-for="InvoiceDate" class="control-label"></label>
            <input asp-for="InvoiceDate" class="form-control" />
            <span class="text-danger" asp-validation-for="InvoiceDate"></span>
        </div>

        
        <div class="form-group">
            <label asp-for="Amount" class="control-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span class="text-danger" asp-validation-for="Amount"></span>
        </div>

        <div class="form-group">
            <label asp-for="PaymentMethod" class="control-label"></label>
            <input asp-for="PaymentMethod" class="form-control" />
            <span class="text-danger" asp-validation-for="PaymentMethod"></span>
        </div>
        
        

        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning mt-3" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>





@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}